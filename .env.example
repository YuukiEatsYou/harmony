# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Display name for this instance.
HARMONY_SERVER_NAME=Harmony

# Interface and port the server listens on.
HARMONY_HOST=127.0.0.1
HARMONY_PORT=8787

# Where the SQLite database and uploaded files live. Defaults to `data/` in the
# repository root; a relative path here resolves against the working directory.
HARMONY_DATA_DIR=data

# Maximum size of a single uploaded image, in megabytes.
HARMONY_MAX_UPLOAD_MB=10

# fatal | error | warn | info | debug | trace | silent
HARMONY_LOG_LEVEL=info

# Require an invite code to register. The first account is always exempt.
# Only the initial default; admins can change this at runtime in the admin panel.
HARMONY_REQUIRE_INVITE=false

# Session lifetime, in days.
HARMONY_SESSION_TTL_DAYS=30

# Name of the session cookie.
HARMONY_COOKIE_NAME=harmony_session

# Set true when serving over HTTPS so the cookie is marked Secure.
HARMONY_COOKIE_SECURE=false

# Set true when running behind a reverse proxy (uses X-Forwarded-For for client IPs).
HARMONY_TRUST_PROXY=false

# How often automatic retention pruning runs, in minutes.
HARMONY_PRUNE_INTERVAL_MINUTES=60

# Scheduled messages: how often (ms) the server checks for ones that are due, and the shortest wait (ms) it accepts.
# Only worth changing for testing.
# HARMONY_SCHEDULED_TICK_MS=10000
# HARMONY_SCHEDULED_MIN_LEAD_MS=30000
