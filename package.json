{
  "name": "harmony",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Discord alternative that makes migrating a small community painless.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @harmony/server",
    "dev:web": "npm run dev --workspace @harmony/web",
    "dev:lan": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web:lan\"",
    "dev:web:lan": "npm run dev:lan --workspace @harmony/web",
    "build:web": "npm run build --workspace @harmony/web",
    "start": "npm run start --workspace @harmony/server",
    "smoke": "npm run smoke --workspace @harmony/server",
    "smoke:bridge": "npm run smoke:bridge --workspace @harmony/server",
    "smoke:sfu": "npm run smoke:sfu --workspace @harmony/server",
    "smoke:text": "npm run smoke:text --workspace @harmony/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
